# Copy to .env and fill in. Never commit .env.

# PostgreSQL password used by docker-compose (generate with: openssl rand -base64 32)
POSTGRES_PASSWORD=

# Public HTTP port of the web container
HTTP_PORT=8080

# API settings (prefix NETLAB_)
NETLAB_ENV=production
# Must be true behind HTTPS (always in production)
NETLAB_COOKIE_SECURE=true
# Super-admins are created on the server: docker compose exec api python -m app.cli create-admin EMAIL
NETLAB_CORS_ORIGINS=["https://netlab.example.org"]
NETLAB_SESSION_DAYS=14
NETLAB_LOGIN_ATTEMPTS_PER_15MIN=10
NETLAB_GRADER_TIMEOUT_S=20
NETLAB_GRADER_MAX_HEAP_MB=256
